rules_version = '2';

// Each signed-in user can only read/write their own paths subcollection.
// Deploy with `firebase deploy --only firestore:rules`, or paste into the
// Firebase console under Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/paths/{pathId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

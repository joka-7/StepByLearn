rules_version = '2';

// StepByLearn no longer uses Firestore: courses sync to each user's own
// Google Drive instead, so the operator holds no copy of anyone's data.
// Deny everything so a leftover database from the earlier cloud sync can't
// be read or written by anyone. Deploy with
// `firebase deploy --only firestore:rules`, or paste into the Firebase
// console under Firestore Database > Rules; then delete the old data there.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

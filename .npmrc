# @joka-7/modeldispatcher-browser-agent is published to GitHub Packages, not
# the public npm registry. Needs a token with read:packages scope in
# NODE_AUTH_TOKEN (locally: export it in your shell; in CI: set it from a
# repo secret). GitHub Packages authenticates every npm read, so this is
# required even though ModelDispatcher itself is now a public repo.
@joka-7:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

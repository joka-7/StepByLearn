# StepByLearn — non-secret configuration knobs.
# Copy to `.env` and adjust. NEVER put your cloud API key here — keys are stored
# in the OS keyring (or the encrypted-at-rest DB fallback), never in plaintext.

# Directory for the local SQLite database and generated data.
# Defaults to the OS-appropriate app-data dir when unset.
# SBL_DATA_DIR=/home/you/.local/share/stepbylearn

# Local FastAPI server bind address.
SBL_HOST=127.0.0.1
SBL_PORT=8000

# Ollama daemon location (local, free engine).
SBL_OLLAMA_BASE_URL=http://localhost:11434
SBL_OLLAMA_MODEL=llama3

# Optional cloud model name (the KEY itself lives in the keyring, not here).
SBL_CLOUD_MODEL=claude-sonnet-5

# Per-request timeout for AI backends, in seconds.
SBL_REQUEST_TIMEOUT_S=120

# Copy to .env.local (gitignored) and fill in with values from your Firebase
# project's Settings > General > Your apps > SDK setup and configuration.
#
# Without these, the app still works fully offline/local — cloud sync (Google
# sign-in) is simply unavailable until they're set.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
